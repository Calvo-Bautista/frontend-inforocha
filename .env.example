# API URL - Backend endpoint
# Local development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Production (example with Render):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
